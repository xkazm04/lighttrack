#!/bin/sh
# Local rung: scan the STAGED DIFF for credentials before it becomes history.
#
# Install once per clone (it is not automatic — git never runs hooks a clone brings with it):
#
#     git config core.hooksPath .githooks
#
# What it reads, and why: the staged content, i.e. the exact bytes about to become a commit. Not the
# working tree — under partial staging those diverge, and a working-tree scan passes or fails on
# content that is not being committed. Not the full history — that is the CI job's business
# (`gitleaks (secrets)` in .github/workflows/ci.yml), which scans all of it on every push.
#
# THE THREE OUTCOMES ARE KEPT DISTINGUISHABLE — found something / found nothing / could not run:
# a missing engine ANNOUNCES ITSELF with an install hint and lets the commit through. Failing the
# commit on a missing tool punishes every fresh clone and teaches people to pass --no-verify, and
# that habit persists into the one commit that mattered. Silence would be worse still: the machine
# without the tool is the machine that leaks. This rung is convenience; the binding rung is CI, on a
# runner that installs the engine itself and that no author can skip.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
    printf '%s\n' \
        "pre-commit: SKIPPED the secret scan — gitleaks is not installed on this machine." \
        "            Install it (https://github.com/gitleaks/gitleaks/releases, or" \
        "            \`brew install gitleaks\` / \`winget install gitleaks\`) to get the fast local" \
        "            answer. CI scans the full history and BLOCKS regardless — this is the cheap" \
        "            rung, not the gate." >&2
elif ! gitleaks git --staged --no-banner --redact --config .gitleaks.toml .; then
    printf '%s\n' \
        "" \
        "pre-commit: a staged change looks like a credential (see the finding above; the value is" \
        "            redacted on purpose)." \
        "" \
        "  If it IS a secret: unstage it. It has not entered history yet, so the fix is still" \
        "  deleting a line rather than rotating a key." \
        "" \
        "  If it is NOT: make the value obviously fake rather than exempting it. If it genuinely" \
        "  must stay, add its FINGERPRINT (not its path) with a reason to .gitleaksignore — a" \
        "  directory exemption is a permanent blind spot where fixtures concentrate." >&2
    exit 1
fi

# Second rung: FORMAT, on the files this commit actually contains.
#
# Formatting was the one blocking gate whose first run was always remote: `-D warnings` and
# `cargo fmt --check` both block in CI, and until now a contributor (or an agent) learned about a
# missing blank line from a red board ten minutes after pushing. `pre-push` closes that for the whole
# set, but the cheapest possible moment is the commit that introduced it.
#
# Why formatting is safe to gate at COMMIT time when the compile gates deliberately are not (see
# .githooks/pre-push): `cargo fmt --check` cannot fail for the reason a work-in-progress commit
# exists. Code that does not compile, does not pass, or is half-written is still perfectly
# formattable. A rung that never fires on legitimate WIP is a rung nobody learns to bypass — and that
# habit, once learned, would take the secret scan above down with it.
#
# Only YOUR staged files can fail it. `cargo fmt` has no way to inspect a subset, so the whole tree is
# checked and then intersected with the staged set: several sessions share this working tree (see
# CLAUDE.md), and being blocked by somebody else's half-formatted file is precisely how a hook gets
# turned off for good.
#
# Same three outcomes as everywhere on this ladder — found something / found nothing / could not run.
# `LIGHTTRACK_SKIP_FMT=1 git commit` bypasses deliberately. CI blocks on the identical command
# regardless, which is where the guarantee lives.
if [ "${LIGHTTRACK_SKIP_FMT:-0}" = "0" ]; then
    staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
    if [ -n "$staged" ]; then
        if ! command -v cargo >/dev/null 2>&1; then
            printf '%s\n' \
                "pre-commit: SKIPPED the format check — cargo is not on PATH. CI still blocks." >&2
        else
            # `-l` lists the files rustfmt would rewrite. It reports absolute paths, with backslashes
            # on Windows, so normalize the separator before matching git's repo-relative names.
            rewrites=$(cargo fmt --all -- --check -l 2>/dev/null | tr '\\' '/' || true)
            offenders=""
            for f in $staged; do
                case "$rewrites" in
                    *"$f"*) offenders="$offenders $f" ;;
                esac
            done
            if [ -n "$offenders" ]; then
                printf '%s\n' "" "pre-commit: staged file(s) are not rustfmt-clean:" >&2
                # Word-splitting is intended: these are repo-relative Rust source paths.
                # shellcheck disable=SC2086
                printf '  %s\n' $offenders >&2
                printf '%s\n' \
                    "" \
                    "  Run \`cargo fmt\` and re-stage. This is the same check CI blocks on" \
                    "  (\`cargo fmt --all -- --check\`): finding it here costs a second, finding it" \
                    "  there costs a push, a runner boot and a red board." \
                    "" \
                    "  LIGHTTRACK_SKIP_FMT=1 git commit  bypasses it deliberately — prefer that to" \
                    "  --no-verify, which also silences the secret scan above." >&2
                exit 1
            fi
        fi
    fi
fi
